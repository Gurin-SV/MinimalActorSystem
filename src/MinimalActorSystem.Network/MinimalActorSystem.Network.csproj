<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);IDE0130</NoWarn>

        <!-- Метаданные пакета -->
        <PackageId>MinimalActorSystem.Network</PackageId>
        <Version>1.0.6</Version>
        <Authors>Сергей Гурин, Россия, Томск. SERGEY GURIN, RUSSIA, TOMSK</Authors>
        <Description>Сетевое расширение для MinimalActorSystem. Прокси-акторы, сериализуемые письма, клиенты маршрутизаторов.</Description>
        <PackageTags>actors;actor-model;networking;distributed-systems;messaging</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MinimalActorSystem\MinimalActorSystem.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System" />
        <Using Include="System.Collections.Generic" />
        <Using Include="System.Threading" />
        <Using Include="System.Threading.Tasks" />
        <Using Include="System.Text.Json" />
        <Using Include="MinimalActorSystem" />
    </ItemGroup>

</Project>