<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>MinimalActorSystem.Network.Http</AssemblyName>
        <RootNamespace>MinimalActorSystem.Network.Http</RootNamespace>
        <Description>HTTP implementation of network transport and router client for MinimalActorSystem.Network.</Description>
        <Version>1.0.0</Version>
        <Authors>Сергей Гурин, Россия, Томск. SERGEY GURIN, RUSSIA, TOMSK</Authors>
        <NoWarn>$(NoWarn);IDE0130</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MinimalActorSystem.Network\MinimalActorSystem.Network.csproj" />
      <ProjectReference Include="..\MinimalActorSystem\MinimalActorSystem.csproj" />
    </ItemGroup>

</Project>
